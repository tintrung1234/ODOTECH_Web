# =========================
# ODOTECH Backend (.env)
# Copy this file to .env and fill in values.
# =========================

# Server
NODE_ENV=development
PORT=5000

# CORS (comma-separated origins)
# Example: http://localhost:8080,http://103.57.220.131:8080
CORS_ORIGIN=http://localhost:8080

# Auth
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Optional encryption key (falls back to JWT_SECRET if omitted)
# ENCRYPTION_KEY=change_me_optional

# =========================
# PostgreSQL
# Prefer DATABASE_URL if you have it; otherwise use the discrete vars.
# =========================

# Option A: single connection string
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Option B: discrete variables
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=odotech
# You can use DATABASE_USER or DATABASE_USERNAME (either works in this codebase)
DATABASE_USER=postgres
# DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Set to true if your DB requires SSL (Neon typically does)
DATABASE_SSL=false

# =========================
# Task Reminder Job (notifications)
# =========================
# Enable/disable the background reminder sweep
TASK_REMINDER_ENABLED=true

# How often to run (ms). Minimum enforced in code: 60000
TASK_REMINDER_INTERVAL_MS=1800000

# Notify tasks due within N days (default 1)
TASK_REMINDER_DUE_BEFORE_DAYS=1

# Include overdue tasks up to N days (default 7)
TASK_REMINDER_OVERDUE_DAYS=7

# Max tasks scanned per sweep
TASK_REMINDER_LIMIT=500
